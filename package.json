{
  "name": "pi-github-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub webhook bot that runs pi agent on issues and PRs",
  "main": "server.ts",
  "scripts": {
    "start": "tsx server.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.74.0",
    "dotenv": "^17.4.2",
    "pino": "^8.21.0",
    "pino-pretty": "^11.2.0",
    "pino-roll": "^2.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
